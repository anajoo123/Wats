# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Server-side only for service_role)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server Session Signing Secret (set a strong random 32+ char secret in production)
SESSION_SECRET=""

# Error Monitoring (Sentry)
SENTRY_DSN=""

# Local persistent database & private storage path (fallback when Supabase is not configured)
DATA_DIR=".data"
